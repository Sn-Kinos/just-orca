{
  "manifestVersion": 2,
  "id": "ryude-desk",
  "name": "류드 결재함",
  "version": "0.5.2",
  "description": "Ryude's desk: the decisions an orchestrator agent needs from you, answered in the right sidebar.",
  "engines": {
    "orca": ">=1.4.248"
  },
  "execution": "trusted-worker",
  "pluginApi": 1,
  "main": "src/worker.ts",
  "contributes": {
    "panels": [
      {
        "id": "ryude-desk",
        "title": "류드 결재함",
        "icon": "layers",
        "entry": "src/panel.tsx",
        "ui": "components"
      }
    ],
    "statusBarItems": [
      {
        "id": "waiting",
        "text": "결재 -",
        "icon": "layers",
        "tooltip": "오른쪽 사이드바의 류드 결재함"
      }
    ]
  },
  "capabilities": [
    {
      "kind": "storage:own"
    },
    {
      "kind": "notifications:show"
    }
  ]
}
